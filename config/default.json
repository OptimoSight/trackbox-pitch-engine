{
  "progress_every_samples": 10,
  "video": {
    "path": "synthetic_pitch_feed.mp4"
  },
  "detector": {
    "type": "color_threshold",
    "lower_hsv": [
      35,
      40,
      40
    ],
    "upper_hsv": [
      85,
      255,
      255
    ],
    "min_area_px": 1000,
    "max_area_ratio": 0.9,
    "scale": 1.0
  },
  "sampling": {
    "sample_fps": 1.0,
    "strategy": "seek",
    "start_seconds": 0.0,
    "max_consecutive_read_failures": 5
  },
  "logging": {
    "level": "INFO",
    "format": "json"
  }
}